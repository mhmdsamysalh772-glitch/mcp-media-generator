# إلزاميان — قاعدة Turso (libSQL)
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<turso-token-with-write-access>

# خدمة دمج الفيديو (مشروع Video Merger API المنشور على Vercel)
MERGER_API_BASE=https://<your-video-merger.vercel.app>

# اختياري — إن ضُبط يُطلب Bearer token على /mcp
MCP_ACCESS_TOKEN=

# اختياري — تجاوز أسماء الموديلات إن لزم
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=

# اختياري — أقصى نافذة انتظار داخل استدعاء الأداة بالثواني (حد أمان لمدة دوال Vercel)
# على خطة Hobby (حد 60 ثانية) اتركها 50؛ على Pro يمكن رفعها حتى 240
MAX_WAIT_SECONDS=50
